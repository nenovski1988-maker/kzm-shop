# Копирай този файл на .env.local и попълни истинските стойности.
# .env.local НИКОГА не се качва в git (вече е в .gitignore по подразбиране).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — Dashboard → Settings → Upload → Upload presets (unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kzm_shop_products

# Админ панел — HTTP Basic Auth (/admin/*)
ADMIN_USER=
ADMIN_PASSWORD=

# Resend — имейли за нови поръчки + форма "Заявка към екипа" от /admin/site
# dashboard: resend.com/api-keys — използвай нов ключ, отделен от ArtIV
RESEND_API_KEY=
# По избор: докато shop.kzm.bg не е верифициран в Resend (Задача 8), остави
# празно — автоматично праща от onboarding@resend.dev (работи веднага, без DNS)
RESEND_FROM_EMAIL=
